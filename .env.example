NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

GOOGLE_SHEET_ID=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# OAuth của tài khoản chủ Drive, dùng để upload file vào Drive
# Lấy refresh token: node scripts/get-drive-token.mjs
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

NEXT_PUBLIC_APP_NAME=Hệ thống Quản lý KLTN

# ============================================================
# EMAIL (Nodemailer / Gmail SMTP)
# Dùng để gửi thông báo nhắc hạn nộp cho giảng viên
# Hướng dẫn lấy App Password Gmail: myaccount.google.com > Bảo mật > Mật khẩu ứng dụng
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM_NAME=Hệ thống KLTN

# Secret để bảo vệ endpoint cron (tạo chuỗi ngẫu nhiên)
CRON_SECRET=your_random_secret_here
